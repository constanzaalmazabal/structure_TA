plot_structure <- function(data, popnames, colours= c("blue", "red"),
invert=FALSE, dis_y=0, title= NULL, ...) {
q_cols <- 6:ncol(data)
data[q_cols] <- data[q_cols] / rowSums(data[q_cols])
ind_per_pop <- table(data$Npop)
gap <- length(data$ID) * 0.003
space <- ifelse(!duplicated(data$Npop), gap, 0)
space[1] <- 0
pop_centers <- cumsum(ind_per_pop) - ind_per_pop / 2 + gap * seq_along(ind_per_pop)
mat <- t(data[q_cols])
if (invert) mat <- 1 - mat
barplot(mat, ylim = c(0, 1), col = colours, main = title,
axes = FALSE, border = NA, space = space, cex.main = 1.5, ...)
axis(2, at = seq(0, 1, 0.2),
labels = format(round(seq(0, 1, 0.2), 2), nsmall = 1),
line = dis_y, las = 1, cex = 0.5)
mtext(popnames, side = 1, at = pop_centers, cex = 1, line = 0.5)
}
png("Structure_plot.png", units = "cm", width = 18, height = 12, res = 300)
